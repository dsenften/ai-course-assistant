# Streamlit Secrets Configuration (Beispiel)
# Diese Datei ist ein Beispiel - kopieren Sie sie zu secrets.toml und fügen Sie echte API-Schlüssel ein

# OpenAI API-Schlüssel (für ChatGPT/GPT-3.5-turbo)
# Erhalten Sie Ihren Schlüssel von: https://platform.openai.com/api-keys
OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Anthropic API-Schlüssel (für Claude)
# Erhalten Sie Ihren Schlüssel von: https://console.anthropic.com/
ANTHROPIC_API_KEY = "sk-ant-api03-your-anthropic-api-key-here"

# Weitere mögliche API-Schlüssel für zukünftige Erweiterungen:
# GOOGLE_API_KEY = "your-google-api-key-here"
# MISTRAL_API_KEY = "your-mistral-api-key-here"

# Setup-Anweisungen:
# 1. Kopieren Sie diese Datei: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Ersetzen Sie die Platzhalter mit echten API-Schlüsseln
# 3. Die secrets.toml Datei wird automatisch von .gitignore ignoriert

# Für Streamlit Cloud Deployment:
# 1. Gehen Sie zu https://share.streamlit.io/
# 2. Wählen Sie Ihr Repository
# 3. Fügen Sie die Secrets in den App-Einstellungen hinzu
